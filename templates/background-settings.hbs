{{#if missing}}
  <p class="notification warning">{{localize "RNPS.Background.Missing"}}</p>
{{else}}
  <div class="rnps-background-settings-content">
    <div class="rnps-background-settings-preview">
      {{#if isVideo}}<video src="{{background.src}}" autoplay loop muted playsinline></video>{{else}}<img src="{{background.src}}" alt="">{{/if}}
    </div>
    <label class="rnps-background-settings-field">{{localize "RNPS.Background.Name"}}<input type="text" data-background-field="name" value="{{background.name}}"></label>
    <label class="rnps-background-settings-field">{{localize "RNPS.Background.Source"}}<span class="rnps-background-source"><input type="text" data-background-field="src" value="{{background.src}}"><button type="button" data-background-browse data-tooltip="{{localize 'RNPS.Background.Browse'}}" aria-label="{{localize 'RNPS.Background.Browse'}}"><i class="fa-solid fa-folder-open" aria-hidden="true"></i></button></span></label>
    <fieldset>
      <legend>{{localize "RNPS.Background.Placement"}}</legend>
      <div class="rnps-background-settings-fit"><span>{{localize "RNPS.Background.Fit"}}</span><button type="button" data-action="cover" class="{{#if fitCover}}active{{/if}}">Cover</button><button type="button" data-action="contain" class="{{#unless fitCover}}active{{/unless}}">Contain</button></div>
      <div class="rnps-background-settings-pair"><label>X <input type="number" min="0" max="100" data-background-field="positionX" value="{{background.positionX}}"></label><label>Y <input type="number" min="0" max="100" data-background-field="positionY" value="{{background.positionY}}"></label></div>
    </fieldset>
    <fieldset>
      <legend>{{localize "RNPS.Background.Effects"}}</legend>
      <div class="rnps-background-settings-pair"><label>{{localize "RNPS.Background.Dim"}} % <input type="number" min="0" max="100" data-background-field="dim" value="{{background.dim}}"></label><label>{{localize "RNPS.Background.Blur"}} px <input type="number" min="0" max="30" data-background-field="blur" value="{{background.blur}}"></label></div>
    </fieldset>
    <label class="hint"><input type="checkbox" disabled> {{localize "RNPS.Background.OverUiLater"}}</label>
    <p class="hint">{{localize "RNPS.Background.DraftHint"}}</p>
  </div>
{{/if}}
