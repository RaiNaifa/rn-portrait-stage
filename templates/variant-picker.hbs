{{#if missing}}
  <p class="notification warning">{{localize "RNPS.Notifications.ActorUnavailable"}}</p>
{{else}}
<div class="rnps-picker-groups">
  {{#each groups as |group|}}
  <details class="rnps-picker-group" {{#if group.open}}open{{/if}}>
    <summary>{{group.name}} <span>{{group.variants.length}}</span></summary>
    <div class="rnps-variant-picker-grid">
    {{#each group.variants as |variant|}}
      <article class="rnps-picker-variant{{#if variant.active}} active{{/if}}" data-variant-id="{{variant.id}}">
        {{#if variant.hasImage}}
          {{#if variant.isVideo}}<video class="{{#if variant.mirrored}}mirrored{{/if}}" src="{{variant.previewImage}}" autoplay loop muted playsinline preload="metadata"></video>{{else}}<img class="{{#if variant.mirrored}}mirrored{{/if}}" src="{{variant.previewImage}}" alt="">{{/if}}
        {{else}}
          <div class="rnps-variant-placeholder" data-tooltip="{{localize 'RNPS.Editor.ImageNotSelected'}}"><i class="fa-solid fa-image" aria-hidden="true"></i><span>{{localize "RNPS.Editor.ImageNotSelected"}}</span></div>
        {{/if}}
        <strong>{{variant.displayName}}</strong>
        <div class="rnps-variant-activation-row">
          <button type="button" data-action="activate" {{#unless variant.hasImage}}disabled{{/unless}}><i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "RNPS.Editor.ActivateVariant"}}</button>
          {{#if @root.isGM}}<button type="button" class="icon" data-action="assign" data-tooltip="{{localize 'RNPS.Editor.ActivateForUsers'}}" {{#unless variant.hasImage}}disabled{{/unless}}><i class="fa-solid fa-users"></i>{{#if variant.assignedUsers}}<span class="rnps-assignment-count">{{variant.assignedUsers}}</span>{{/if}}</button>{{/if}}
        </div>
      </article>
    {{/each}}
    </div>
  </details>
  {{/each}}
</div>
{{/if}}
