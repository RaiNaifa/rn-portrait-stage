<div class="rnps-manager-content">
  {{#if hasScene}}
    <p class="hint">{{hint}}</p>
    <div class="rnps-manager-groups">
      {{#each groups as |group|}}
        <section class="rnps-manager-group" data-group-id="{{group.id}}">
          <header>
            <h2>{{group.label}}</h2>
            <span class="rnps-count">{{group.entries.length}}</span>
          </header>
          <div class="rnps-manager-list">
            {{#each group.entries as |portrait|}}
              <article class="rnps-manager-entry{{#unless portrait.visible}} rnps-manager-entry--hidden{{/unless}}{{#if portrait.missing}} rnps-manager-entry--missing{{/if}}" draggable="{{@root.isGM}}" data-entry-id="{{portrait.id}}" data-actor-uuid="{{portrait.actorUuid}}">
                <img src="{{portrait.image}}" alt="" loading="lazy">
                {{#if portrait.missing}}
                  <span class="rnps-entry-name">{{portrait.name}}</span>
                {{else}}
                  <button type="button" class="rnps-entry-name" data-action="openActor" title="{{localize 'RNPS.Controls.OpenActor'}}">
                    {{portrait.name}}
                  </button>
                {{/if}}
                {{#if @root.isGM}}
                  <div class="rnps-entry-actions">
                    {{#unless portrait.missing}}
                      <button type="button" data-action="edit" title="{{localize 'RNPS.Controls.Edit'}}">
                        <i class="fa-solid fa-gear" aria-hidden="true"></i>
                      </button>
                    {{/unless}}
                    <button type="button" data-action="remove" title="{{localize 'RNPS.Controls.Remove'}}">
                      <i class="fa-solid fa-trash" aria-hidden="true"></i>
                    </button>
                  </div>
                {{/if}}
              </article>
            {{else}}
              <div class="rnps-manager-empty">
                <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                <span>{{localize "RNPS.Manager.Empty"}}</span>
              </div>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>
  {{else}}
    <p class="notification warning">{{localize "RNPS.Manager.NoScene"}}</p>
  {{/if}}
</div>
