<div class="rnps-manager-content">
  {{#if hasScene}}
    <div class="rnps-manager-main">
    <div class="rnps-manager-toolbar rnps-layer-visibility">
      {{#each visibilityZones as |zone|}}
        <div class="rnps-layer-visibility-zone" data-visibility-layer="{{zone.id}}">
          <span>{{zone.label}}</span>
          <button type="button" class="rnps-layer-eye{{#if zone.shared}} active{{/if}}" data-action="toggleSharedLayer" data-tooltip="{{zone.sharedTooltip}}" aria-label="{{zone.sharedTooltip}}">
            <i class="fa-solid {{#if zone.shared}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i><i class="fa-solid fa-users rnps-layer-audience" aria-hidden="true"></i>
          </button>
          <button type="button" class="rnps-layer-eye{{#if zone.self}} active{{/if}}" data-action="toggleClientLayer" data-tooltip="{{zone.selfTooltip}}" aria-label="{{zone.selfTooltip}}">
            <i class="fa-solid {{#if zone.self}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i><i class="fa-solid fa-user rnps-layer-audience" aria-hidden="true"></i>
          </button>
        </div>
      {{/each}}
    </div>
    <nav class="rnps-manager-tabs">
      <button type="button" class="{{#if compositionTab}}active{{/if}}" data-action="showComposition">{{localize "RNPS.Manager.Composition"}}</button>
      <button type="button" class="{{#if presetsTab}}active{{/if}}" data-action="showPresets">{{localize "RNPS.Presets.Title"}}</button>
      <button type="button" class="{{#if backgroundTab}}active{{/if}}" data-action="showBackground">{{localize "RNPS.Presets.SectionBackground"}}</button>
      <button type="button" class="rnps-background-expand{{#if sidebarOpen}} active{{/if}}" data-action="toggleBackgroundSidebar" data-tooltip="{{#if sidebarOpen}}{{localize 'RNPS.Background.Collapse'}}{{else}}{{localize 'RNPS.Background.Expand'}}{{/if}}" aria-label="{{#if sidebarOpen}}{{localize 'RNPS.Background.Collapse'}}{{else}}{{localize 'RNPS.Background.Expand'}}{{/if}}" {{#unless compositionTab}}disabled{{/unless}}><i class="fa-solid {{#if sidebarOpen}}fa-angles-left{{else}}fa-angles-right{{/if}}" aria-hidden="true"></i></button>
    </nav>
    {{#if editorTab}}
      <div class="rnps-preview-bar">
        <span><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> {{localize "RNPS.Preview.Draft"}}</span>
        {{#if previewStale}}<span class="warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "RNPS.Preview.Stale"}}</span>{{/if}}
        <button type="button" class="{{#if previewDirty}}dirty{{else}}no-changes{{/if}}" data-action="applyPreview" {{#if autoApplyLocksActions}}disabled{{/if}}><i class="fa-solid fa-check"></i> {{localize "RNPS.Preview.ApplyChanges"}}</button>
        <button type="button" class="{{#unless previewDirty}}no-changes{{/unless}}" data-action="resetPreview" {{#if autoApplyLocksActions}}disabled{{/if}}><i class="fa-solid fa-rotate-left"></i> {{localize "RNPS.Preview.ResetChanges"}}</button>
        <label class="rnps-preview-auto-apply" data-tooltip="{{localize 'RNPS.Preview.AutoApplyHint'}}"><input type="checkbox" data-action="togglePreviewAutoApply" {{#if previewAutoApply}}checked{{/if}}> {{localize "RNPS.Preview.AutoApply"}}</label>
      </div>
    {{/if}}
    {{#if compositionTab}}
    <section class="rnps-presentation-settings">
      <div class="rnps-focus-settings-header">
        <h2>{{localize "RNPS.Focus.Title"}}</h2>
        <span data-tooltip="{{#if focusEditMode}}{{localize 'RNPS.FocusEdit.Disable'}}{{else}}{{#if focusEditAvailable}}{{localize 'RNPS.FocusEdit.Enable'}}{{else}}{{localize 'RNPS.FocusEdit.Empty'}}{{/if}}{{/if}}">
          <button type="button" class="rnps-focus-edit-toggle{{#if focusEditMode}} active{{/if}}" data-action="toggleFocusEditMode" aria-pressed="{{#if focusEditMode}}true{{else}}false{{/if}}" aria-label="{{#if focusEditMode}}{{localize 'RNPS.FocusEdit.Disable'}}{{else}}{{localize 'RNPS.FocusEdit.Enable'}}{{/if}}" {{#unless focusEditMode}}{{#unless focusEditAvailable}}disabled{{/unless}}{{/unless}}>
            <span>{{localize "RNPS.FocusEdit.Mode"}}</span>
            <span class="rnps-focus-edit-switch" aria-hidden="true"><span></span></span>
            <span class="rnps-focus-edit-status">{{#if focusEditMode}}{{localize "RNPS.FocusEdit.On"}}{{else}}{{localize "RNPS.FocusEdit.Off"}}{{/if}}</span>
          </button>
        </span>
      </div>
      <div class="rnps-focus-settings-zones">
        {{#each focusZones as |zone|}}
          <section class="rnps-focus-manager-zone" data-focus-drop="{{zone.id}}">
            <h3>{{zone.label}}</h3>
            {{#if zone.assigned}}
              <div class="rnps-manager-entry rnps-focus-manager-card{{#unless zone.visible}} rnps-manager-entry--hidden{{/unless}}" draggable="true" data-focus-actor="{{zone.actorUuid}}" data-focus-entry="{{zone.entryId}}">
                {{#if zone.isVideo}}<video class="{{#if zone.mirrored}}mirrored{{/if}}" src="{{zone.image}}" autoplay loop muted playsinline preload="metadata"></video>{{else}}<img class="{{#if zone.mirrored}}mirrored{{/if}}" src="{{zone.image}}" alt="">{{/if}}
                <span class="rnps-entry-name">{{zone.name}}</span>
                <div class="rnps-entry-actions rnps-entry-actions--top">
                  <button type="button" data-action="editFocus" data-tooltip="{{localize 'RNPS.Controls.Edit'}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
                  <button type="button" data-action="clearFocus" data-tooltip="{{localize 'RNPS.Focus.Remove'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                </div>
                <div class="rnps-entry-actions rnps-entry-actions--bottom">
                  <button type="button" class="{{#if zone.entryMirrored}}active{{/if}}" data-action="toggleFocusMirror" data-tooltip="{{localize 'RNPS.Controls.Mirror'}}"><i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i></button>
                  <button type="button" class="rnps-persistent-button{{#if zone.persistent}} active{{/if}}" data-action="toggleFocusPersistent" data-tooltip="{{localize 'RNPS.Controls.Persistent'}}"><i class="fa-solid {{#if zone.persistent}}fa-link{{else}}fa-link-slash{{/if}}" aria-hidden="true"></i></button>
                  <button type="button" class="{{#unless zone.visible}}active{{/unless}}" data-action="toggleFocusVisible" data-tooltip="{{#if zone.visible}}{{localize 'RNPS.Controls.Hide'}}{{else}}{{localize 'RNPS.Controls.Show'}}{{/if}}"><i class="fa-solid {{#if zone.visible}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i></button>
                </div>
              </div>
            {{else}}
              <div class="rnps-focus-manager-empty"><i class="fa-solid fa-arrow-down"></i> {{localize "RNPS.Manager.Empty"}}</div>
            {{/if}}
          </section>
        {{/each}}
      </div>
    </section>
    <div class="rnps-composition-body">
    <div class="rnps-manager-groups">
      {{#each groups as |group|}}
        <section class="rnps-manager-group" data-group-id="{{group.id}}">
          <header>
            <div class="rnps-manager-group-heading">
              <h2>{{localize "RNPS.Visibility.Side"}}</h2>
              <div><h3>{{group.label}}</h3><span class="rnps-count">{{group.entries.length}}</span></div>
            </div>
            <div class="rnps-manager-size">
              <span>{{localize "RNPS.Manager.PortraitSize"}}</span>
              <button type="button" data-size-reset="{{group.id}}" data-tooltip="{{localize 'RNPS.Manager.ResetPortraitSize'}}" aria-label="{{localize 'RNPS.Manager.ResetPortraitSize'}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
              <input name="{{group.id}}PortraitSize" type="range" min="{{@root.portraitSizeMin}}" max="{{@root.portraitSizeMax}}" step="1" value="{{group.portraitSize}}" aria-label="{{localize 'RNPS.Manager.PortraitSize'}}">
              <input type="number" min="{{@root.portraitSizeMin}}" max="{{@root.portraitSizeMax}}" step="1" value="{{group.portraitSize}}" data-size-output="{{group.id}}" aria-label="{{localize 'RNPS.Manager.PortraitSize'}}">
            </div>
          </header>
          <div class="rnps-manager-list">
            {{#each group.entries as |portrait|}}
              <article class="rnps-manager-entry{{#unless portrait.visible}} rnps-manager-entry--hidden{{/unless}}{{#if portrait.missing}} rnps-manager-entry--missing{{/if}}" draggable="{{@root.isGM}}" data-entry-id="{{portrait.id}}" data-layer="{{portrait.entry.layer}}" data-actor-uuid="{{portrait.actorUuid}}">
                {{#if portrait.draftConflict}}<i class="rnps-entry-conflict fa-solid fa-triangle-exclamation" data-tooltip="{{portrait.draftConflictTooltip}}"></i>{{/if}}
                {{#if portrait.isVideo}}<video class="{{#if portrait.mirrored}}mirrored{{/if}}" src="{{portrait.image}}" autoplay loop muted playsinline preload="metadata"></video>{{else}}<img class="{{#if portrait.mirrored}}mirrored{{/if}}" src="{{portrait.image}}" alt="" loading="lazy">{{/if}}
                {{#if portrait.missing}}
                  <span class="rnps-entry-name">{{portrait.name}}</span>
                {{else}}
                  <span class="rnps-entry-name">{{portrait.name}}</span>
                {{/if}}
                {{#if @root.isGM}}
                  {{#if portrait.personalizedUsers}}<span class="rnps-manager-assignment" data-tooltip="{{portrait.personalizedSummary}}">{{#each portrait.personalizedVariants as |assignment|}}<span class="rnps-manager-assignment-variant" data-tooltip="{{assignment.tooltip}}">{{#if assignment.isVideo}}<video class="{{#if assignment.mirrored}}mirrored{{/if}}" src="{{assignment.image}}" autoplay loop muted playsinline preload="metadata"></video>{{else}}<img class="{{#if assignment.mirrored}}mirrored{{/if}}" src="{{assignment.image}}" alt="">{{/if}}<b>{{assignment.count}}</b></span>{{/each}}</span>{{/if}}
                  <div class="rnps-entry-actions rnps-entry-actions--top">
                    {{#unless portrait.missing}}<button type="button" data-action="edit" data-tooltip="{{localize 'RNPS.Controls.Edit'}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>{{/unless}}
                    <button type="button" data-action="remove" data-tooltip="{{localize 'RNPS.Controls.Remove'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                  </div>
                  <div class="rnps-entry-actions rnps-entry-actions--bottom">
                    <button type="button" class="{{#if portrait.entry.mirrored}}active{{/if}}" data-action="toggleMirror" data-tooltip="{{localize 'RNPS.Controls.Mirror'}}"><i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i></button>
                    <button type="button" class="rnps-persistent-button{{#if portrait.persistent}} active{{/if}}" data-action="togglePersistent" data-tooltip="{{localize 'RNPS.Controls.Persistent'}}"><i class="fa-solid {{#if portrait.persistent}}fa-link{{else}}fa-link-slash{{/if}}" aria-hidden="true"></i></button>
                    <button type="button" class="{{#unless portrait.visible}}active{{/unless}}" data-action="toggleVisible" data-tooltip="{{#if portrait.visible}}{{localize 'RNPS.Controls.Hide'}}{{else}}{{localize 'RNPS.Controls.Show'}}{{/if}}"><i class="fa-solid {{#if portrait.visible}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i></button>
                  </div>
                {{/if}}
              </article>
            {{else}}
              <div class="rnps-manager-empty"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i><span>{{localize "RNPS.Manager.Empty"}}</span></div>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>

    <footer class="rnps-reserve" data-reserve-drop style="--rnps-reserve-height: {{reserveHeight}}px">
      <div class="rnps-reserve-resize" data-reserve-resize data-tooltip="{{localize 'RNPS.Manager.ResizeReserve'}}"></div>
      <header><h2>{{localize "RNPS.Manager.Reserve"}}</h2></header>
      <div class="rnps-reserve-list{{#unless reserve.length}} rnps-reserve-list--empty{{/unless}}">
        {{#each reserve as |actor|}}
          <article class="rnps-manager-entry rnps-reserve-actor{{#unless actor.visible}} rnps-manager-entry--hidden{{/unless}}" draggable="true" data-reserve-actor data-entry-id="{{actor.id}}" data-actor-uuid="{{actor.actorUuid}}" data-tooltip="{{actor.name}}">
            {{#if actor.isVideo}}<video class="{{#if actor.mirrored}}mirrored{{/if}}" src="{{actor.image}}" autoplay loop muted playsinline preload="metadata"></video>{{else}}<img class="{{#if actor.mirrored}}mirrored{{/if}}" src="{{actor.image}}" alt="">{{/if}}
            <div class="rnps-entry-actions rnps-entry-actions--top">
              <button type="button" class="{{#if actor.entry.flags.reserveFavorite}}active{{/if}}" data-action="toggleReserveFavorite" data-tooltip="{{#if actor.entry.flags.reserveFavorite}}{{localize 'RNPS.Manager.RemoveFavorite'}}{{else}}{{localize 'RNPS.Manager.AddFavorite'}}{{/if}}"><i class="fa-solid fa-star" aria-hidden="true"></i></button>
              <button type="button" data-action="editReserve" data-tooltip="{{localize 'RNPS.Controls.Edit'}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
              <button type="button" data-action="removeReserve" data-tooltip="{{localize 'RNPS.Manager.RemoveReserve'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
            </div>
            <div class="rnps-entry-actions rnps-entry-actions--bottom">
              <button type="button" class="{{#if actor.entry.mirrored}}active{{/if}}" data-action="toggleReserveMirror" data-tooltip="{{localize 'RNPS.Controls.Mirror'}}"><i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i></button>
              <button type="button" class="{{#if actor.persistent}}active{{/if}}" data-action="toggleReservePersistent" data-tooltip="{{localize 'RNPS.Controls.Persistent'}}"><i class="fa-solid {{#if actor.persistent}}fa-link{{else}}fa-link-slash{{/if}}" aria-hidden="true"></i></button>
              <button type="button" class="{{#unless actor.visible}}active{{/unless}}" data-action="toggleReserveVisible" data-tooltip="{{#if actor.visible}}{{localize 'RNPS.Controls.Hide'}}{{else}}{{localize 'RNPS.Controls.Show'}}{{/if}}"><i class="fa-solid {{#if actor.visible}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i></button>
            </div>
          </article>
        {{else}}
          <div class="rnps-manager-empty rnps-reserve-empty"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i><span>{{localize "RNPS.Manager.Empty"}}</span></div>
        {{/each}}
      </div>
    </footer>
    </div>
    {{else if backgroundTab}}
      <section class="rnps-background-editor rnps-background-editor--full">
        <header class="rnps-background-library-header">
          <h2>{{localize "RNPS.Background.Title"}}</h2>
          <span class="rnps-background-header-actions"><button type="button" data-action="toggleBackgroundFollowActive" class="rnps-background-follow{{#if backgroundFollowActive}} active{{/if}}" data-tooltip="{{#if backgroundFollowActive}}{{localize 'RNPS.Background.Unpin'}}{{else}}{{localize 'RNPS.Background.Pin'}}{{/if}}" aria-label="{{#if backgroundFollowActive}}{{localize 'RNPS.Background.Unpin'}}{{else}}{{localize 'RNPS.Background.Pin'}}{{/if}}" {{#unless hasActiveBackground}}{{#unless backgroundFollowActive}}disabled{{/unless}}{{/unless}}><i class="fa-solid fa-link" aria-hidden="true"></i></button><button type="button" data-action="addBackgroundGroup" data-tooltip="{{localize 'RNPS.Background.AddGroup'}}" aria-label="{{localize 'RNPS.Background.AddGroup'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><i class="fa-solid fa-layer-group" aria-hidden="true"></i></button><button type="button" data-action="addBackground" data-tooltip="{{localize 'RNPS.Background.Add'}}" aria-label="{{localize 'RNPS.Background.Add'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><i class="fa-solid fa-image" aria-hidden="true"></i></button></span>
        </header>
        <div class="rnps-background-search-row"><label class="rnps-background-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-background-search value="{{backgroundSearch}}" placeholder="{{localize 'RNPS.Background.Search'}}" aria-label="{{localize 'RNPS.Background.Search'}}"></label><button type="button" class="rnps-background-find-active" data-action="findActiveBackground" data-tooltip="{{localize 'RNPS.Background.FindActive'}}" aria-label="{{localize 'RNPS.Background.FindActive'}}" {{#unless hasActiveBackground}}disabled{{/unless}}><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button></div>
        <div class="rnps-background-groups">
          {{#each backgroundGroups as |group|}}
            <section class="rnps-background-group{{#if group.collapsed}} collapsed{{/if}}{{#if group.active}} active{{/if}}" data-background-group="{{group.id}}" data-background-group-name="{{group.name}}">
              <header class="rnps-background-group-header">
                <button type="button" data-action="toggleBackgroundGroup" data-tooltip="{{#if group.collapsed}}{{localize 'RNPS.Background.ExpandGroup'}}{{else}}{{localize 'RNPS.Background.CollapseGroup'}}{{/if}}" aria-label="{{#if group.collapsed}}{{localize 'RNPS.Background.ExpandGroup'}}{{else}}{{localize 'RNPS.Background.CollapseGroup'}}{{/if}}" aria-expanded="{{#unless group.collapsed}}true{{else}}false{{/unless}}"><i class="fa-solid {{#if group.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i></button>
                {{#if group.isDefault}}<h3>{{group.name}}</h3>{{else}}<span class="rnps-background-group-name" data-background-group-label draggable="true" data-tooltip="{{localize 'RNPS.Background.GroupNameHint'}}">{{group.name}}</span><input type="text" data-background-group-name value="{{group.name}}" aria-label="{{localize 'RNPS.Background.GroupName'}}" hidden>{{/if}}<button type="button" data-action="addBackground" data-tooltip="{{localize 'RNPS.Background.AddToGroup'}}" aria-label="{{localize 'RNPS.Background.AddToGroup'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><i class="fa-solid fa-image" aria-hidden="true"></i></button>{{#unless group.isDefault}}<button type="button" data-action="removeBackgroundGroup" data-tooltip="{{localize 'RNPS.Background.RemoveGroup'}}" aria-label="{{localize 'RNPS.Background.RemoveGroup'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/unless}}
              </header>
              <div class="rnps-background-list">
                {{#each group.backgrounds as |item|}}
                  <article class="rnps-background-card{{#if item.active}} active{{/if}}" draggable="true" data-background-id="{{item.id}}" data-background-name="{{item.name}}">
                    {{#if item.isVideo}}<video src="{{item.src}}" muted loop playsinline preload="metadata"></video>{{else}}<img src="{{item.src}}" alt="" loading="lazy">{{/if}}
                    <span class="rnps-background-card-name" data-tooltip="{{item.name}}">{{item.name}}</span>
                    <button type="button" class="rnps-background-preload {{item.preload.state}}" data-action="preloadBackground" data-tooltip="{{item.preloadTooltip}}" aria-label="{{item.preloadTooltip}}"><i class="fa-solid {{#if item.preloadLoading}}fa-spinner fa-spin{{else if item.preloadReady}}fa-circle-check{{else if item.preloadFailed}}fa-triangle-exclamation{{else}}fa-cloud-arrow-down{{/if}}" aria-hidden="true"></i>{{#unless item.preloadIdle}}<span>{{item.preload.ready}}/{{item.preload.total}}</span>{{/unless}}</button>
                    <div class="rnps-background-card-actions">
                      <button type="button" data-action="toggleActiveBackground" class="{{#if item.active}}active{{/if}}" data-tooltip="{{#if item.active}}{{localize 'RNPS.Background.Deactivate'}}{{else}}{{localize 'RNPS.Background.Activate'}}{{/if}}" aria-label="{{#if item.active}}{{localize 'RNPS.Background.Deactivate'}}{{else}}{{localize 'RNPS.Background.Activate'}}{{/if}}"><i class="fa-solid {{#if item.active}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i></button>
                      <button type="button" data-action="editBackground" data-tooltip="{{localize 'RNPS.Background.Settings'}}" aria-label="{{localize 'RNPS.Background.Settings'}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
                      <button type="button" data-action="removeBackground" data-tooltip="{{localize 'RNPS.Background.Remove'}}" aria-label="{{localize 'RNPS.Background.Remove'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                    </div>
                  </article>
                {{else}}<p class="hint rnps-background-group-empty">{{localize "RNPS.Background.DropHint"}}</p>{{/each}}
              </div>
            </section>
          {{/each}}
        </div>
        <p class="hint rnps-background-no-results" data-background-no-results hidden>{{localize "RNPS.Background.NoResults"}}</p>
      </section>
    {{else}}
      <section class="rnps-presets">
        <p class="rnps-presets-placeholder">{{localize "RNPS.Presets.ComingSoon"}}</p>
      </section>
    {{/if}}
    </div>
    {{#if sidebarOpen}}
      <div class="rnps-manager-sidebar">
      {{#if litmIntegrationEnabled}}
        <div class="rnps-manager-extension-toolbar">
          <div class="rnps-layer-visibility-zone rnps-litm-visibility-zone">
            <span><i class="fa-solid fa-tags" data-tooltip="{{localize 'RNPS.Integrations.Litm.TagsHint'}}" aria-label="{{localize 'RNPS.Integrations.Litm.TagsHint'}}"></i> {{localize "RNPS.Integrations.Litm.TagsForCast"}}</span>
            <button type="button" data-action="showAllLitmTags" data-tooltip="{{localize 'RNPS.Integrations.Litm.ShowAllTags'}}" aria-label="{{localize 'RNPS.Integrations.Litm.ShowAllTags'}}"><i class="fa-solid fa-eye" aria-hidden="true"></i></button>
            <button type="button" data-action="hideAllLitmTags" data-tooltip="{{localize 'RNPS.Integrations.Litm.HideAllTags'}}" aria-label="{{localize 'RNPS.Integrations.Litm.HideAllTags'}}"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i></button>
          </div>
        </div>
      {{/if}}
      <aside class="rnps-background-editor rnps-background-editor--sidebar">
        <header class="rnps-background-library-header">
          <h2>{{localize "RNPS.Background.Title"}}</h2>
          <span class="rnps-background-header-actions"><button type="button" data-action="toggleBackgroundFollowActive" class="rnps-background-follow{{#if backgroundFollowActive}} active{{/if}}" data-tooltip="{{#if backgroundFollowActive}}{{localize 'RNPS.Background.Unpin'}}{{else}}{{localize 'RNPS.Background.Pin'}}{{/if}}" aria-label="{{#if backgroundFollowActive}}{{localize 'RNPS.Background.Unpin'}}{{else}}{{localize 'RNPS.Background.Pin'}}{{/if}}" {{#unless hasActiveBackground}}{{#unless backgroundFollowActive}}disabled{{/unless}}{{/unless}}><i class="fa-solid fa-link" aria-hidden="true"></i></button><button type="button" data-action="addBackgroundGroup" data-tooltip="{{localize 'RNPS.Background.AddGroup'}}" aria-label="{{localize 'RNPS.Background.AddGroup'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><i class="fa-solid fa-layer-group" aria-hidden="true"></i></button><button type="button" data-action="addBackground" data-tooltip="{{localize 'RNPS.Background.Add'}}" aria-label="{{localize 'RNPS.Background.Add'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><i class="fa-solid fa-image" aria-hidden="true"></i></button></span>
        </header>
        <div class="rnps-background-search-row"><label class="rnps-background-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-background-search value="{{backgroundSearch}}" placeholder="{{localize 'RNPS.Background.Search'}}" aria-label="{{localize 'RNPS.Background.Search'}}"></label><button type="button" class="rnps-background-find-active" data-action="findActiveBackground" data-tooltip="{{localize 'RNPS.Background.FindActive'}}" aria-label="{{localize 'RNPS.Background.FindActive'}}" {{#unless hasActiveBackground}}disabled{{/unless}}><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button></div>
        <div class="rnps-background-groups">
          {{#each backgroundGroups as |group|}}
            <section class="rnps-background-group{{#if group.collapsed}} collapsed{{/if}}{{#if group.active}} active{{/if}}" data-background-group="{{group.id}}" data-background-group-name="{{group.name}}">
              <header class="rnps-background-group-header">
                <button type="button" data-action="toggleBackgroundGroup" data-tooltip="{{#if group.collapsed}}{{localize 'RNPS.Background.ExpandGroup'}}{{else}}{{localize 'RNPS.Background.CollapseGroup'}}{{/if}}" aria-label="{{#if group.collapsed}}{{localize 'RNPS.Background.ExpandGroup'}}{{else}}{{localize 'RNPS.Background.CollapseGroup'}}{{/if}}" aria-expanded="{{#unless group.collapsed}}true{{else}}false{{/unless}}"><i class="fa-solid {{#if group.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i></button>
                {{#if group.isDefault}}<h3>{{group.name}}</h3>{{else}}<span class="rnps-background-group-name" data-background-group-label draggable="true" data-tooltip="{{localize 'RNPS.Background.GroupNameHint'}}">{{group.name}}</span><input type="text" data-background-group-name value="{{group.name}}" aria-label="{{localize 'RNPS.Background.GroupName'}}" hidden>{{/if}}<button type="button" data-action="addBackground" data-tooltip="{{localize 'RNPS.Background.AddToGroup'}}" aria-label="{{localize 'RNPS.Background.AddToGroup'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><i class="fa-solid fa-image" aria-hidden="true"></i></button>{{#unless group.isDefault}}<button type="button" data-action="removeBackgroundGroup" data-tooltip="{{localize 'RNPS.Background.RemoveGroup'}}" aria-label="{{localize 'RNPS.Background.RemoveGroup'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/unless}}
              </header>
              <div class="rnps-background-list">
                {{#each group.backgrounds as |item|}}
                  <article class="rnps-background-card{{#if item.active}} active{{/if}}" draggable="true" data-background-id="{{item.id}}" data-background-name="{{item.name}}">
                    {{#if item.isVideo}}<video src="{{item.src}}" muted loop playsinline preload="metadata"></video>{{else}}<img src="{{item.src}}" alt="" loading="lazy">{{/if}}
                    <span class="rnps-background-card-name" data-tooltip="{{item.name}}">{{item.name}}</span>
                    <button type="button" class="rnps-background-preload {{item.preload.state}}" data-action="preloadBackground" data-tooltip="{{item.preloadTooltip}}" aria-label="{{item.preloadTooltip}}"><i class="fa-solid {{#if item.preloadLoading}}fa-spinner fa-spin{{else if item.preloadReady}}fa-circle-check{{else if item.preloadFailed}}fa-triangle-exclamation{{else}}fa-cloud-arrow-down{{/if}}" aria-hidden="true"></i>{{#unless item.preloadIdle}}<span>{{item.preload.ready}}/{{item.preload.total}}</span>{{/unless}}</button>
                    <div class="rnps-background-card-actions">
                      <button type="button" data-action="toggleActiveBackground" class="{{#if item.active}}active{{/if}}" data-tooltip="{{#if item.active}}{{localize 'RNPS.Background.Deactivate'}}{{else}}{{localize 'RNPS.Background.Activate'}}{{/if}}" aria-label="{{#if item.active}}{{localize 'RNPS.Background.Deactivate'}}{{else}}{{localize 'RNPS.Background.Activate'}}{{/if}}"><i class="fa-solid {{#if item.active}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i></button>
                      <button type="button" data-action="editBackground" data-tooltip="{{localize 'RNPS.Background.Settings'}}" aria-label="{{localize 'RNPS.Background.Settings'}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
                      <button type="button" data-action="removeBackground" data-tooltip="{{localize 'RNPS.Background.Remove'}}" aria-label="{{localize 'RNPS.Background.Remove'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                    </div>
                  </article>
                {{else}}<p class="hint rnps-background-group-empty">{{localize "RNPS.Background.DropHint"}}</p>{{/each}}
              </div>
            </section>
          {{/each}}
        </div>
        <p class="hint rnps-background-no-results" data-background-no-results hidden>{{localize "RNPS.Background.NoResults"}}</p>
      </aside>
      </div>
    {{/if}}
  {{else}}
    <p class="notification warning">{{localize "RNPS.Manager.NoScene"}}</p>
  {{/if}}
</div>
