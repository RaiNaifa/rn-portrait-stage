{{#if missing}}
  <p class="notification warning">{{localize "RNPS.Notifications.ActorUnavailable"}}</p>
{{else}}
  <div class="rnps-editor-content">
    <div class="rnps-editor-preview">
      {{#if previewIsVideo}}<video src="{{previewImage}}" autoplay loop muted playsinline preload="metadata"></video>{{else}}<img src="{{previewImage}}" alt="">{{/if}}
      <fieldset class="rnps-editor-label">
        <legend>{{localize "RNPS.Editor.Label"}}</legend>
        <div class="form-group">
          <label for="rnps-label-mode">{{localize "RNPS.Editor.LabelMode"}}</label>
          <div class="form-fields"><select id="rnps-label-mode" name="labelMode">
            <option value="actor" {{#if labelUsesActor}}selected{{/if}}>{{localize "RNPS.Editor.ActorName"}}</option>
            <option value="prototypeToken" {{#if labelUsesPrototypeToken}}selected{{/if}}>{{localize "RNPS.Editor.PrototypeTokenName"}}</option>
            <option value="custom" {{#if labelIsCustom}}selected{{/if}}>{{localize "RNPS.Editor.CustomLabel"}}</option>
            <option value="hidden" {{#if labelIsHidden}}selected{{/if}}>{{localize "RNPS.Editor.HiddenLabel"}}</option>
          </select></div>
        </div>
        <div class="form-group" data-custom-label-field>
          <label for="rnps-custom-label">{{localize "RNPS.Editor.CustomLabel"}}</label>
          <div class="form-fields"><input id="rnps-custom-label" name="customLabel" type="text" value="{{customLabel}}"></div>
        </div>
      </fieldset>
    </div>

    <fieldset class="rnps-variant-editor">
      <legend>{{localize "RNPS.Editor.Variants"}}</legend>
      {{#if isGM}}<button type="button" class="rnps-configure-groups" data-action="configureGroups"><i class="fa-solid fa-layer-group"></i> {{localize "RNPS.VariantGroups.Configure"}}</button>{{/if}}
      <input type="hidden" name="activeVariantId" value="{{activeVariantId}}">
      <div class="rnps-editor-variant-groups">
      {{#each variantGroups as |group|}}
        <section class="rnps-editor-variant-group">
          <header><h3>{{group.displayName}}</h3><span>{{group.variants.length}}</span></header>
          <div class="rnps-variant-grid" data-variant-group="{{group.id}}" data-default-group="{{group.isDefault}}">
        {{#each group.variants as |variant|}}
          <section class="rnps-variant-tile{{#if variant.selected}} active{{/if}}" data-variant-tile data-variant-id="{{variant.id}}">
            <input type="hidden" name="variantId" value="{{variant.id}}">
            <input type="hidden" name="variantSource" value="{{variant.image.source}}">
            {{#if variant.hasImage}}
              {{#if variant.isVideo}}<video src="{{variant.previewImage}}" autoplay loop muted playsinline preload="metadata"></video>{{else}}<img src="{{variant.previewImage}}" alt="">{{/if}}
            {{else}}
              <div class="rnps-variant-placeholder" data-tooltip="{{localize 'RNPS.Editor.ImageNotSelected'}}"><i class="fa-solid fa-image" aria-hidden="true"></i><span>{{localize "RNPS.Editor.ImageNotSelected"}}</span></div>
            {{/if}}
            {{#if variant.isBuiltin}}
              <input type="hidden" name="variantName" value="{{variant.name}}">
              <input type="hidden" name="variantPath" value="">
              <strong>{{variant.displayName}}</strong>
            {{else}}
              <input type="text" name="variantName" value="{{variant.name}}" aria-label="{{localize 'RNPS.Editor.VariantName'}}">
              <file-picker name="variantPath" type="imagevideo" value="{{variant.image.customSrc}}"></file-picker>
            {{/if}}
            {{#if @root.canConfigure}}
              <div class="rnps-variant-configure-row">
                <button type="button" data-action="configureVariant"><i class="fa-solid fa-sliders" aria-hidden="true"></i> {{localize "RNPS.Editor.ConfigureVariant"}}</button>
                {{#unless variant.isBuiltin}}<button type="button" class="icon" data-action="removeVariant" data-tooltip="{{localize 'RNPS.Editor.DeleteVariant'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/unless}}
              </div>
            {{/if}}
            <div class="rnps-variant-activation-row">
              <button type="button" data-action="activateVariant" {{#unless variant.hasImage}}disabled{{/unless}}><i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "RNPS.Editor.ActivateVariant"}}</button>
              {{#if @root.isGM}}<button type="button" class="icon" data-action="assignVariant" data-tooltip="{{localize 'RNPS.Editor.ActivateForUsers'}}" {{#unless variant.hasImage}}disabled{{/unless}}><i class="fa-solid fa-users" aria-hidden="true"></i>{{#if variant.assignedUsers}}<span class="rnps-assignment-count">{{variant.assignedUsers}}</span>{{/if}}</button>{{/if}}
            </div>
          </section>
        {{/each}}
          </div>
        </section>
      {{/each}}
      </div>
      <button type="button" data-action="addVariant"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "RNPS.Editor.AddVariant"}}</button>
      <template id="rnps-new-variant-template">
        <section class="rnps-variant-tile" data-variant-tile data-variant-id="">
          <input type="hidden" name="variantId" value="">
          <input type="hidden" name="variantSource" value="custom">
          <div class="rnps-variant-placeholder"><i class="fa-solid fa-image" aria-hidden="true"></i><span>{{localize "RNPS.Editor.ImageNotSelected"}}</span></div>
          <input type="text" name="variantName" value="{{localize 'RNPS.Editor.NewVariant'}}" aria-label="{{localize 'RNPS.Editor.VariantName'}}">
          <file-picker name="variantPath" type="imagevideo"></file-picker>
          <div class="rnps-variant-configure-row"><button type="button" data-action="configureVariant"><i class="fa-solid fa-sliders" aria-hidden="true"></i> {{localize "RNPS.Editor.ConfigureVariant"}}</button><button type="button" class="icon" data-action="removeVariant" data-tooltip="{{localize 'RNPS.Editor.DeleteVariant'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></div>
          <div class="rnps-variant-activation-row"><button type="button" data-action="activateVariant" disabled><i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "RNPS.Editor.ActivateVariant"}}</button>{{#if isGM}}<button type="button" class="icon" data-action="assignVariant" disabled><i class="fa-solid fa-users"></i></button>{{/if}}</div>
        </section>
      </template>
    </fieldset>
  </div>
{{/if}}
